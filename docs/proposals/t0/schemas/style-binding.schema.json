{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/se-panfilov/ai_girls_generator/docs/proposals/t0/schemas/style-binding.schema.json",
  "title": "Style binding (PROPOSAL aigg.style-binding/0.1, NONAUTHORITATIVE)",
  "description": "PROPOSAL from the T0 ADR. How one style profile revision is applied with one base model family. A binding is model-specific. A change of the model family needs a new binding and a new style check.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "bindingId", "revision", "status", "style", "baseFamily", "components", "requires", "useCases", "evaluations", "approvals"],
  "properties": {
    "schema": { "const": "aigg.style-binding/0.1" },
    "bindingId": { "$ref": "common.schema.json#/$defs/id" },
    "revision": { "$ref": "common.schema.json#/$defs/revision" },
    "status": { "$ref": "common.schema.json#/$defs/lifecycle" },
    "style": { "$ref": "common.schema.json#/$defs/recordRef" },
    "baseFamily": { "enum": ["sdxl"] },
    "components": {
      "description": "Applied together. An empty list is not permitted. Use kind prompt_only for the baseline.",
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "positive", "negative"],
            "properties": {
              "kind": { "const": "prompt_only" },
              "positive": { "type": "string", "maxLength": 1000 },
              "negative": { "type": "string", "maxLength": 1000 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "adapter", "encoder", "references", "scaleMode", "scale"],
            "properties": {
              "kind": { "const": "reference_image" },
              "adapter": { "$ref": "common.schema.json#/$defs/recordRef" },
              "encoder": { "$ref": "common.schema.json#/$defs/recordRef" },
              "references": {
                "description": "Asset ids from the style profile. Never an identity image.",
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "common.schema.json#/$defs/id" }
              },
              "scaleMode": { "enum": ["all_blocks", "style_blocks_only"] },
              "scale": { "type": "number", "minimum": 0, "maximum": 1.5 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "lora", "weight", "trigger"],
            "properties": {
              "kind": { "const": "lora" },
              "lora": { "$ref": "common.schema.json#/$defs/recordRef" },
              "weight": { "type": "number", "minimum": -2, "maximum": 2 },
              "trigger": { "type": "string", "maxLength": 100 }
            }
          }
        ]
      }
    },
    "requires": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/capability" }
    },
    "useCases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["concept", "production_design", "part_completion"] }
    },
    "evaluations": {
      "description": "Results of the style consistency gate for this binding.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evaluationId", "result", "evidenceSha256"],
        "properties": {
          "evaluationId": { "$ref": "common.schema.json#/$defs/id" },
          "result": { "enum": ["pass", "fail", "incomplete"] },
          "evidenceSha256": { "$ref": "common.schema.json#/$defs/sha256" }
        }
      }
    },
    "approvals": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/approval" } }
  }
}
