{
  "name": "@aigg/control",
  "version": "0.2.0",
  "description": "Make pose control images, proportion references, ComfyUI workflows, and rig overlays from the rig contract",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26.12.1"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "bin": {
    "aigg-control": "dist/src/cli.js"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --ignore-path ../../.prettierignore --check .",
    "start": "npm run build && node dist/src/cli.js"
  }
}
