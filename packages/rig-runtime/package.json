{
  "name": "@aigg/rig-runtime",
  "version": "0.1.2",
  "description": "Assemble character skins on one shared Spine skeleton, swap part modules at run time, and check asset manifests",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26.12.1"
  },
  "exports": {
    ".": "./dist/src/index.js",
    "./node": "./dist/src/node.js"
  },
  "bin": {
    "aigg-rig-runtime": "dist/src/cli.js"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --ignore-path ../../.prettierignore --check .",
    "start": "npm run build && node dist/src/cli.js"
  }
}
